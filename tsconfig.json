{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": { "@/*": ["./frontend/src/*"], "@shared/*": ["./shared/*"] }
  },
  "include": ["tests", "shared", "frontend/src", "backend/src"]
}
